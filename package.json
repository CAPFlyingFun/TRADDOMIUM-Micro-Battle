{
  "name": "traddomium-micro-battle",
  "private": true,
  "version": "0.50.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "probe:spawn": "node scripts/probe-spawn.mjs",
    "probe:weather": "node scripts/probe-weather.mjs",
    "probe:lod": "node scripts/probe-lod.mjs",
    "probe:reach": "node scripts/probe-reach.mjs",
    "probe:viewport": "node scripts/probe-viewport.mjs",
    "probe:loading": "node scripts/probe-loading.mjs",
    "probe:telemetry": "node scripts/probe-telemetry.mjs",
    "plates": "node scripts/plates.mjs",
    "hud:draft": "node scripts/hudDraft.mjs",
    "probe:streak": "node scripts/probe-streak.mjs",
    "shots": "node scripts/shots.mjs",
    "probe:island": "node scripts/probe-island.mjs",
    "icons": "node scripts/make-icons.mjs",
    "bake:queen": "node scripts/bakeQueen.mjs",
    "shots:hud": "node scripts/hudshot.mjs",
    "probe:hydro": "node scripts/probe-hydro.mjs",
    "bake:hydro": "python3 scripts/bakeHydro.py",
    "rivers:scale": "python3 scripts/riversToScale.py",
    "probe:ocean": "node scripts/probe-ocean.mjs",
    "probe:update": "node scripts/probe-update.mjs",
    "probe:lakes": "node scripts/probe-lakes.mjs",
    "probe:surf": "node scripts/probe-surf.mjs",
    "probe:rivers": "node scripts/probe-rivers.mjs",
    "bake:veg": "python3 scripts/bakeVeg.py"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.4.2",
    "@types/node": "^24.0.0",
    "@types/three": "^0.180.0",
    "playwright": "^1.62.1",
    "typescript": "^5.8.3",
    "vite": "^7.0.0",
    "vitest": "^3.2.4"
  }
}
