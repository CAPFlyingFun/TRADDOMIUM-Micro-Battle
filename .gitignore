node_modules
dist
*.local
.DS_Store
tsconfig.tsbuildinfo
shots/
probe-*.png
.scratch/

# Wrangler's local Workers state. `npm run relay:dev` and `npm run
# probe:relay` run the real workerd runtime on this machine and write the
# room's local Durable Object SQLite beside worker/wrangler.toml. It is
# one developer's scratch state, never the relay's truth.
.wrangler/

# Agent worktrees created during parallel builds
.claude/worktrees/

# The art masters under art/ are COMMITTED. scripts/bakeArt.mjs reads them
# to produce everything in public/ AND to measure the loading bar's cutout,
# so a clone without them cannot rebuild the splash. The exceptions are
# here so a future scratch-render rule (v0 had `*.png`) cannot drop them.
!art/*.png
!art/*.jpg

# THE HUMAN MASTERS ARE NOT COMMITTED, and they are the one exception to
# the rule above. Jack-Lab.glb and Sarah-Lab.glb are 45 MB and 33 MB —
# 82 MB that would sit in every clone of this repository forever, to be
# read by one script that turns them into 7.7 MB of `public/models/`.
#
# Their master store is the GitHub release `Jack_Sarah_Lab_Models_GLB`,
# which already holds them unchanged and with a checksum (Joshua,
# 2026-09-18: "Preserve the master GLBs unchanged"). `bake:humans` prints
# the one-line fetch when the directory is empty.
art/humans/*

# ...EXCEPT the front panels. `bake:panels` writes `<who>-front.png`, an
# orthographic picture of the chest that CAN be painted — unlike the master
# atlas, which is 103,000 per-triangle islands and where any ordinary image
# edit bleeds one body part into another. A `<who>-front-edited.png` beside it
# is hand work and belongs in the repository; the reference is committed with
# it so an edit can be diffed without re-baking a 33 MB master.
!art/humans/panels/
!art/humans/panels/*.png
# THE BADGE IS AUTHORED ART, not a master scan: Joshua drew the TOMBS card
# and the bake prints it onto the ID hanging round Sarah's neck. It is 0.8 MB
# and it is the only copy in the repository, so it is tracked.
!art/humans/badge/
!art/humans/badge/*.webp

# The occlusion bake, derived from a master and cached so the next run does
# not pay two minutes a body for it again.
art/humans/cache/
