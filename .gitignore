node_modules
dist
*.local
.DS_Store
tsconfig.tsbuildinfo
shots/
probe-*.png
.scratch/

# Wrangler's local Workers state. `npm run relay:dev` and `npm run
# probe:relay` run the real workerd runtime on this machine and write the
# room's local Durable Object SQLite beside worker/wrangler.toml. It is
# one developer's scratch state, never the relay's truth.
.wrangler/

# Agent worktrees created during parallel builds
.claude/worktrees/

# The art masters under art/ are COMMITTED. scripts/bakeArt.mjs reads them
# to produce everything in public/ AND to measure the loading bar's cutout,
# so a clone without them cannot rebuild the splash. The exceptions are
# here so a future scratch-render rule (v0 had `*.png`) cannot drop them.
!art/*.png
!art/*.jpg
